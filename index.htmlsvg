  <p class="message">You seem to be lost. Are you looking for <a id="way-out" href="https://www.google.com">Google</a>?</p>
  <script>
    (function () {
      var places = [
        { href: "https://www.agendalx.pt", label: "Agenda LX" },
        { href: "https://www.visit.brussels/en/visitors/agenda", label: "the Brussels agenda" },
        { href: "https://visit.gent.be/en", label: "Visit Gent" },
        { href: "https://agendaculturalporto.org", label: "Agenda Cultural Porto" },
        { href: "https://www.google.com", label: "Google" }
      ];
      var pick = places[Math.floor(Math.random() * places.length)];
      var link = document.getElementById("way-out");
      link.href = pick.href;
      link.textContent = pick.label;

      var sun = document.getElementById("sun");
      var root = document.documentElement;

      function paint() {
        var now = new Date();
        var hour = now.getHours() + now.getMinutes() / 60;
        var sky = "night";
        if (hour >= 5 && hour < 8) sky = "dawn";
        else if (hour >= 8 && hour < 17) sky = "day";
        else if (hour >= 17 && hour < 20.5) sky = "dusk";
        root.setAttribute("data-sky", sky);

        var theme = {
          dawn: "#e7a48c",
          day: "#8eafbf",
          dusk: "#c4624a",
          night: "#101826"
        };
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme[sky]);

        var t = (hour - 6) / 14;
        if (t < 0) t = 0;
        if (t > 1) t = 1;
        var x = 90 + t * 1020;
        var y = 250 - Math.sin(t * Math.PI) * 180;
        sun.setAttribute("cx", String(Math.round(x)));
        sun.setAttribute("cy", String(Math.round(y)));
        var halo = document.getElementById("sun-halo");
        if (halo) {
          halo.setAttribute("cx", String(Math.round(x)));
          halo.setAttribute("cy", String(Math.round(y)));
        }
      }

      paint();
      setInterval(paint, 60000);
    }());
  </script>
</body>
</html>
